# ── Window Focus ───────────────────────────────────────────────────
hyper - left : yabai -m window --focus west
hyper - right : yabai -m window --focus east

alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

alt - s : yabai -m display --focus west
alt - g : yabai -m display --focus east

# ── Space Focus ────────────────────────────────────────────────────
# NOTE: you have to disable SPI to do these
alt - 1 : yabai -m space --focus "D1";
alt - 2 : yabai -m space --focus "D2";
alt - 3 : yabai -m space --focus "D3";
alt - 4 : yabai -m space --focus "D4";
alt - 5 : yabai -m space --focus "D5";
alt - 6 : yabai -m space --focus "D6";

hyper - 1 : yabai -m space --focus "D1";
hyper - 2 : yabai -m space --focus "D2";
hyper - 3 : yabai -m space --focus "D3";
hyper - 4 : yabai -m space --focus "D4";
hyper - 5 : yabai -m space --focus "D5";
hyper - 6 : yabai -m space --focus "D6";

alt - tab : yabai -m space --focus next || yabai -m space --focus first
alt + shift - tab : yabai -m space --focus prev || yabai -m space --focus last

# ── Layout ─────────────────────────────────────────────────────────
shift + alt - r : yabai -m space --rotate 270
shift + alt - y : yabai -m space --mirror y-axis
shift + alt - x : yabai -m space --mirror x-axis

# ── Window Size ────────────────────────────────────────────────────
shift + alt - m : yabai -m window --toggle zoom-fullscreen
shift + alt - f : yabai -m window --toggle float

# ── Window Move ────────────────────────────────────────────────────
# swap
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# warp (move + split)
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - l : yabai -m window --warp east

# move to display
shift + alt - s : yabai -m window --display west; yabai -m display --focus west;
shift + alt - g : yabai -m window --display east; yabai -m display --focus east;

# move to prev/next space
# NOTE: you have to disable SPI to do these
# shift + alt - p : yabai -m window --space prev;
# shift + alt - n : yabai -m window --space next;

# move to space
# NOTE: you have to disable SPI to do these
shift + alt - 1 : yabai -m window --space "D1";
shift + alt - 2 : yabai -m window --space "D2";
shift + alt - 3 : yabai -m window --space "D3";
shift + alt - 4 : yabai -m window --space "D4";
shift + alt - 5 : yabai -m window --space "D5";
shift + alt - 6 : yabai -m window --space "D6";

# ── Yabai Service ──────────────────────────────────────────────────
ctrl + alt - q : yabai --stop-service
ctrl + alt - s : skhd --restart-service
ctrl + alt - y : yabai --restart-service
