# ── Scripting Addition ──────────────────────────────────────────────
# https://github.com/asmvik/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# ── Layout ──────────────────────────────────────────────────────────
yabai -m config layout bsp

# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# ── Padding & Gaps ─────────────────────────────────────────────────
# Using external_bar config to apply 38px padding globally
# to all spaces regardless of the monitors
yabai -m config external_bar all:38:8

# global padding
yabai -m config \
        bottom_padding 8 \
        left_padding 8 \
        right_padding 8 \
        window_gap 8

