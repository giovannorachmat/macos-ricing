# Configure scripting addition
# https://github.com/asmvik/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# default layout (can be bsp, stack or float)
yabai -m config layout bsp

# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

yabai -m config --display 0 external_bar all:20:0
yabai -m config --display 1 external_bar all:30:0

if command -v sketchybar &>/dev/null; then
  # Check the display size (e.g., grab the resolution here)
  display_resolution=$(system_profiler SPDisplaysDataType | grep Resolution)

  if [[ "$display_resolution" == *"3024 x 1964"* ]]; then
    yabai -m config top_padding 10
    yabai -m config bottom_padding 8
    yabai -m config left_padding 8
    yabai -m config right_padding 8
    yabai -m config window_gap 8
  elif [[ "$display_resolution" == *"2560 x 1440"* ]]; then
    yabai -m config top_padding 38
    yabai -m config bottom_padding 8
    yabai -m config left_padding 8
    yabai -m config right_padding 8
    yabai -m config window_gap 8
  fi
fi

opacity_value=0.87

yabai -m config window_opacity on
# yabai -m config window_opacity off

# -- mouse settings --

# center mouse on window with focus
yabai -m config \
  mouse_follows_focus on \
  focus_follows_mouse autofocus \
  mouse_modifier alt \ # modifier for clicking and dragging with mouse
  config mouse_action1 move \  # set modifier + left-click drag to move window
  config mouse_action2 resize \ # set modifier + right-click drag to resize window
  mouse_drop_action swap # when window is dropped in center of another window, swap them (on edges it will split it)

# disable automatic tiling in specific apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Karabiner-EventViewer$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^WireGuard$" manage=off
yabai -m rule --add app="^Bitwarden$" manage=off
yabai -m rule --add app="^Logi Options$" manage=off
yabai -m rule --add app="^SF Symbols$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="net.whatsapp.WhatsApp" manage=off
yabai -m rule --add app="^eqMac$" manage=off
yabai -m rule --add app="^Tailscale$" manage=off
